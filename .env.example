# Copy this file to .env and fill in your keys:   cp .env.example .env
# .env is in .gitignore, so it will not be committed. Never commit real keys.

# Providers to try, in priority order. If one is overloaded or rate-limited,
# the next one is used. Remove any you don't have a key for.
PROVIDERS=gemini,groq,cerebras

# Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash

# Groq  (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=

# Cerebras  (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# OpenRouter  (https://openrouter.ai/keys)  - model ids ending in :free are free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (local, no key). Add "ollama" to PROVIDERS to use it.
OLLAMA_MODEL=

# --- Sandbox for the bash tool (needs bubblewrap, see SANDBOX.md) ---
#   auto = use the sandbox when it works, otherwise run commands UNSANDBOXED with a
#          warning in the prompt (default)
#   on   = require it; refuse to run commands if it is not working
#   off  = never use it
# You can change this while SLOP is running:  /sandbox on|auto|off
SLOP_SANDBOX=auto
# Network inside the sandbox. off = no pip install / git push / downloads.
# While running:  /sandbox net on|off
SLOP_SANDBOX_NETWORK=off
# Extra folders visible read-only inside the sandbox, separated by ":"
# (for example a pyenv or conda install, or Playwright's browsers)
SLOP_SANDBOX_RO=

# --- Optional: cap on how long one model reply may be (in tokens) ---
# Stops small local models from repeating themselves until the request times out.
# A number, or "off" for no cap. Default: 4096 for ollama, no cap for the others.
# OLLAMA_MAX_TOKENS=4096
# GROQ_MAX_TOKENS=
# CEREBRAS_MAX_TOKENS=
# OPENROUTER_MAX_TOKENS=

# --- Optional: how much conversation is sent with each request (in characters, ~4 per token) ---
# Older tool output is shortened and the oldest turns are left out beyond this (see /context).
# A number (at least 4000), or "off". Defaults: ollama 16000, groq 40000, others 200000.
# SLOP_CONTEXT_CHARS=            # one limit for every provider
# OLLAMA_CONTEXT_CHARS=16000     # per-provider limits win over SLOP_CONTEXT_CHARS
# GROQ_CONTEXT_CHARS=40000

# --- Optional: show a short excerpt of each tool result in the terminal ---
# so you can see what the model was actually told. on (default) or off.
# SLOP_SHOW_OUTPUT=on
