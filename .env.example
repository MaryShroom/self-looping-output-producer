# Copy this file to .env and fill in your keys:   cp .env.example .env
# .env is in .gitignore, so it will not be committed. Never commit real keys.

# Providers to try, in priority order. If one is overloaded or rate-limited,
# the next one is used. Remove any you don't have a key for.
PROVIDERS=gemini,groq,cerebras

# Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash

# Groq  (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=

# Cerebras  (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# OpenRouter  (https://openrouter.ai/keys)  - model ids ending in :free are free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (local, no key). Add "ollama" to PROVIDERS to use it.
OLLAMA_MODEL=
